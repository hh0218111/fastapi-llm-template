# ============================================================
# 环境变量模板 —— 复制成 .env 后按需修改
# .env 已被 .gitignore 挡住，不会进 Git；这个模板文件会进 Git，给别人看要配什么
# 说明：字段名大小写不敏感，对应 app/core/config.py 里的 Settings 字段
# ============================================================

# 应用名（会显示在 /docs 页面标题）
APP_NAME="fastapi-llm-template"

# 密钥：生产环境必须换成随机长串，泄露 = 全站可伪造
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-here"

# 以下两项 D5（JWT 鉴权）启用，当前 Settings 里还没定义，extra="ignore" 会先忽略
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL="INFO"
